DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=backend.example.invalid
DJANGO_CORS_ALLOWED_ORIGINS=https://frontend.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://frontend.example.invalid

DB_ENGINE=django.db.backends.mysql
DB_NAME=replace-with-railway-mysql-database
DB_USER=replace-with-railway-mysql-user
DB_PASSWORD=replace-with-railway-mysql-password
DB_HOST=replace-with-railway-private-mysql-host
DB_PORT=3306

TIME_ZONE=Africa/Lagos
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1
DJANGO_USE_PROXY_SSL_HEADER=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_API_DOCS_PUBLIC=False
FRONTEND_URL=https://frontend.example.invalid
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@example.invalid
SHOW_DEMO_CREDENTIALS=False
ALLOW_DEMO_ACCOUNTS=False
ALLOW_DEMO_DATA_PURGE=False
ALLOW_MEDIA_UPLOADS=False
